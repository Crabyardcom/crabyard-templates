# ─────────────────────────────────────────────────────────────────────────────
# Crabyard Scaffold — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub OAuth (auth-github module) ─────────────────────────────────────────
# Create a GitHub OAuth App at: https://github.com/settings/developers
# - Application name:   {{APP_NAME}}
# - Homepage URL:       http://localhost
# - Callback URL:       (leave blank — Device Flow doesn't use it)
# After creating the app, copy the Client ID below.
GITHUB_CLIENT_ID=your_github_client_id_here

# ── App display name (shown in title bar and login screen) ───────────────────
# The generator fills this in automatically from your project config.
VITE_APP_NAME={{APP_NAME}}
